# systemd unit for this box's deployment (paths are this host's).
# Install: cp deploy/*.service deploy/*.timer /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now heightmap-studio
[Unit]
Description=Battlefield Heightmap Studio (uvicorn :8000)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/repos/limp-bases/heightmap-studio
Environment=HOME=/root
ExecStart=/root/repos/limp-bases/heightmap-studio/.venv/bin/uvicorn server.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
